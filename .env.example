NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_PROPERTY_VIDEO_MAX_SIZE_MB=50

# Optional server-only key for the Google Business live profile.
GOOGLE_PLACES_API_KEY=

# Optional public key for the embedded map; restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Never expose or commit a Supabase service-role/secret key in frontend code.
